<?xml version="1.0" encoding="utf-8" ?>
<UserControl
  x:Class="WinApp.UserControls.MangaBasicInfo.TagTextBlock"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:local="using:WinApp.UserControls"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:strings="using:UnoLibrary.Strings"
  mc:Ignorable="d"
>
  <UserControl.ContextFlyout>
    <MenuFlyout>
      <MenuFlyoutItem
        Command="{x:Bind ViewModel.CopyCommand, Mode=OneWay}"
        CommandParameter="{x:Bind Text}"
        Text="{strings:Strings Uid=Copy}"
      />
      <MenuFlyoutItem
        Command="{x:Bind NavigatetoSearchCommand}"
        CommandParameter="{x:Bind Text}"
        Text="{strings:Strings Uid=SearchThisTag}"
      />
    </MenuFlyout>
  </UserControl.ContextFlyout>
  <Border Background="{x:Bind Converter={StaticResource randomcolor}}">
    <TextBlock x:Name="textblock" Margin="4" FontSize="16" Text="{x:Bind Text, Mode=OneWay}" />
  </Border>
</UserControl>
