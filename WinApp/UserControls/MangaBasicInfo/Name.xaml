<?xml version="1.0" encoding="utf-8" ?>
<UserControl
  x:Class="WinApp.UserControls.MangaBasicInfo.Name"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:local="using:WinApp.UserControls.MangaBasicInfo"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:strings="using:UnoLibrary.Strings"
  mc:Ignorable="d"
>
  <TextBlock x:Name="manganameTextblock" FontSize="20" Text="{x:Bind Manga.Name, Mode=OneWay}">
    <TextBlock.ContextFlyout>
      <MenuFlyout>
        <MenuFlyoutItem
          Command="{x:Bind ViewModel.CopyCommand, Mode=OneWay}"
          CommandParameter="{x:Bind Manga.Name, Mode=OneWay}"
          Text="{strings:Strings Uid=Copy}"
        />
        <MenuFlyoutItem
          Command="{x:Bind NavigateCommand}"
          CommandParameter="{x:Bind Manga.Name, Mode=OneWay}"
          Text="{strings:Strings Uid=Search}"
        />
      </MenuFlyout>
    </TextBlock.ContextFlyout>
  </TextBlock>
</UserControl>
