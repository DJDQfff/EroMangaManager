<?xml version="1.0" encoding="utf-8" ?>
<UserControl
  x:Class="WinApp.UserControls.MangasGridView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:basic="using:WinApp.UserControls.MangaBasicInfo"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:local="using:WinApp.UserControls"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:models="using:Core.Models"
  xmlns:uid="using:UnoLibrary.Strings"
  xmlns:uno="using:UnoLibrary"
  x:Name="usercontrol"
  mc:Ignorable="d"
>
  <UserControl.Resources>
    <MenuFlyout x:Key="mangaflyout" Opening="MenuFlyout_Opening">
      <MenuFlyoutSubItem
        x:Name="openwith"
        Icon="OpenWith"
        Loading="openwith_Loading"
        Text="{uid:Strings Uid=OpenWithExternal}"
      />
      <MenuFlyoutItem
        x:Name="LocateItem"
        Icon="OpenLocal"
        Text="{uid:Strings Uid=LocateInExplorer}"
      />
      <MenuFlyoutSubItem
        x:Name="moveto"
        Icon="MoveToFolder"
        Loading="moveto_Loading"
        Text="{uid:Strings Uid=MoveToOtherFolder}"
      />
      <MenuFlyoutItem
        x:Name="OverviewInformation"
        Icon="View"
        Text="{uid:Strings Uid=OverviewInformation}"
      />
      <MenuFlyoutItem x:Name="Rename" Icon="Rename" Text="{uid:Strings Uid=RenameFile}" />
      <MenuFlyoutItem x:Name="Export" Icon="Save" Text="{uid:Strings Uid=ExportToPDF}" />
      <MenuFlyoutSeparator />
      <MenuFlyoutItem
        x:Name="Delete"
        Foreground="Red"
        Icon="Delete"
        Text="{uid:Strings Uid=DeleteIt}"
      />
    </MenuFlyout>

    <DataTemplate x:Key="Template0" x:DataType="models:Manga">
      <Grid
        ContextFlyout="{StaticResource mangaflyout}"
        DoubleTapped="Grid_DoubleTapped"
        RowDefinitions="auto,*,auto"
      >
        <basic:Cover
          x:Name="cover"
          Grid.Row="0"
          Width="166"
          Height="192"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          Manga="{x:Bind Mode=OneWay}"
        />
        <basic:Name
          x:Name="name"
          Grid.Row="1"
          Width="150"
          Margin="1"
          Padding="2"
          Manga="{x:Bind Mode=OneWay}"
          CopyCommand="{Binding  MangaOperationViewModel.ClipboardHelperCopyCommand, ElementName=usercontrol, Mode=OneWay}"
          NavigateCommand="{Binding MangaOperationViewModel.NavigateSearchNameCommand, ElementName=usercontrol, Mode=OneWay}"
        />
        <uno:SizeImagesChaptersAmount x:Name="info" Grid.Row="2" Manga="{x:Bind Mode=OneWay}" />
      </Grid>
    </DataTemplate>
    <DataTemplate x:Key="Template1" x:DataType="models:Manga">
      <Grid
        Width="300"
        ContextFlyout="{StaticResource mangaflyout}"
        DoubleTapped="Grid_DoubleTapped"
        RowDefinitions="auto,*,auto"
      >
        <basic:Name
          x:Name="name"
          Manga="{x:Bind Mode=OneWay}"
          CopyCommand="{Binding  MangaOperationViewModel.ClipboardHelperCopyCommand, ElementName=usercontrol, Mode=OneWay}"
          NavigateCommand="{Binding MangaOperationViewModel.NavigateSearchNameCommand, ElementName=usercontrol, Mode=OneWay}"
        />
        <Grid Grid.Row="1" ColumnDefinitions="*,*">
          <basic:Cover x:Name="cover" Grid.Column="0" Manga="{x:Bind Mode=OneWay}" />
          <basic:TagsItemRepeater
            x:Name="tags"
            Grid.Column="1"
            Manga="{x:Bind Mode=OneWay}"
            CopyCommand="{Binding  MangaOperationViewModel.ClipboardHelperCopyCommand, ElementName=usercontrol, Mode=OneWay}"
            NavigateCommand="{Binding MangaOperationViewModel.NavigateSearchTagsCommand, ElementName=usercontrol, Mode=OneWay}"
          />
        </Grid>
        <uno:SizeImagesChaptersAmount x:Name="info" Grid.Row="2" Manga="{x:Bind Mode=OneWay}" />
      </Grid>
    </DataTemplate>

    <DataTemplate x:Key="Template2" x:DataType="models:Manga">
      <Grid
        MaxWidth="500"
        ContextFlyout="{StaticResource mangaflyout}"
        ColumnDefinitions="*,2*"
        DoubleTapped="Grid_DoubleTapped"
      >
        <basic:Cover Grid.Column="0" Manga="{x:Bind Mode=OneWay}" />
        <Grid Grid.Column="1" RowDefinitions="auto,5*,auto,auto">
          <basic:Name
            Manga="{x:Bind Mode=OneWay}"
            CopyCommand="{Binding  MangaOperationViewModel.ClipboardHelperCopyCommand, ElementName=usercontrol, Mode=OneWay}"
            NavigateCommand="{Binding MangaOperationViewModel.NavigateSearchNameCommand, ElementName=usercontrol, Mode=OneWay}"
          />
          <TextBlock
            Grid.Row="1"
            Text="{x:Bind FolderPath, Mode=OneWay}"
            TextAlignment="Justify"
            TextWrapping="Wrap"
          />
          <TextBlock Grid.Row="2" Text="{x:Bind FileFullName, Mode=OneWay}" TextWrapping="Wrap" />
          <uno:SizeImagesChaptersAmount Grid.Row="3" Manga="{x:Bind Mode=OneWay}" />
        </Grid>
      </Grid>
    </DataTemplate>
  </UserControl.Resources>
  <GridView
    x:Name="gridview"
    IsItemClickEnabled="False"
    ItemTemplate="{StaticResource Template0}"
    ItemContainerStyle="{ThemeResource GridViewItemRevealStyle}"
    ItemsSource="{x:Bind MangaSource, Mode=OneWay}"
    SelectionMode="Single"
  />
</UserControl>
