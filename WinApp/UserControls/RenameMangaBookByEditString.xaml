<?xml version="1.0" encoding="utf-8" ?>
<UserControl
  x:Class="WinApp.UserControls.RenameMangaByEditString"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mangainfo="using:WinApp.UserControls.MangaBasicInfo"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:uid="using:UnoLibrary.Strings"
  MaxHeight="400"
  mc:Ignorable="d"
>
  <UserControl.Resources>
    <Style TargetType="TextBlock">
      <Setter Property="FontSize" Value="20" />
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="FontSize" Value="20" />
    </Style>
    <Style TargetType="Button">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="Margin" Value="4" />
    </Style>
  </UserControl.Resources>

  <Grid ColumnDefinitions="auto,*">
    <mangainfo:Cover x:Name="coverimage" Manga="{x:Bind Manga, Mode=OneWay}" />
    <Grid Grid.Column="1" HorizontalAlignment="Stretch" RowDefinitions="*,*">
      <StackPanel>
        <TextBlock Text="{x:Bind Manga.FolderPath, Mode=OneWay}" />
        <TextBlock
          x:Name="oldname"
          VerticalAlignment="Center"
          Text="{x:Bind Manga.FileDisplayName, Mode=OneWay}"
          TextWrapping="Wrap"
        />
      </StackPanel>
      <StackPanel Grid.Row="2" Orientation="Vertical">
        <TextBlock
          x:Name="hinttextblock"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          Foreground="Red"
          HorizontalTextAlignment="Center"
        />
        <Grid HorizontalAlignment="Stretch" VerticalAlignment="Center" ColumnDefinitions="*,auto">
          <TextBox
            x:Name="textbox"
            IsSpellCheckEnabled="False"
            TextChanged="TextBox_TextChanged"
            TextWrapping="Wrap"
          />
          <TextBlock
            x:Name="aaa"
            Grid.Column="1"
            VerticalAlignment="Center"
            x:Load="False"
            Text="{x:Bind Manga.Type, Mode=OneTime}"
            TextWrapping="Wrap"
          />
        </Grid>

        <Button
          x:Name="RenameButton"
          Grid.Row="4"
          Command="{x:Bind RenameCommand}"
          Content="{uid:Strings Uid=RenameFile}"
        />
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>
