<?xml version="1.0" encoding="utf-8" ?>
<UserControl
  x:Class="WinApp.UserControls.ManageMangaOpenWay3Setting"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:setting="using:CommunityToolkit.WinUI.Controls"
  xmlns:uid="using:UnoLibrary.Strings"
  mc:Ignorable="d"
>
  <UserControl.Resources>
    <MenuFlyout x:Key="flyout">
      <MenuFlyoutItem
        Command="{x:Bind ViewModel.RemoveExePathCommand}"
        CommandParameter="{Binding}"
        DataContext="{Binding}"
        Text="{uid:Strings Uid=Remove}"
      />
    </MenuFlyout>
  </UserControl.Resources>

  <setting:SettingsExpander x:Name="MangaOpenWay" Header="{uid:Strings Uid=MangaOpenWay}">
    <setting:SettingsExpander.ItemsHeader>
      <!--  不知道为什么，只使用selecteditem无法数据绑定，必须通过selectedindex来获取  -->
      <!--  SelectedIndex="{x:Bind app:App.Current.AppConfig.AppConfig.MangaOpenWay3.WayIndex, Mode=TwoWay}"  -->
      <RadioButtons
        ItemsSource="{x:Bind ViewModel.ExePaths, Mode=OneWay}"
        SelectedItem="{x:Bind ViewModel.DefaultWay, Mode=TwoWay}"
      >
        <RadioButtons.ItemTemplate>
          <DataTemplate x:DataType="x:String">
            <RadioButton
              Content="{x:Bind Converter={StaticResource uistringconverter}}"
              ContextFlyout="{StaticResource flyout}"
              DataContext="{x:Bind}"
            />
          </DataTemplate>
        </RadioButtons.ItemTemplate>
      </RadioButtons>
    </setting:SettingsExpander.ItemsHeader>
    <setting:SettingsExpander.ItemsFooter>
      <Button
        HorizontalAlignment="Stretch"
        Command="{x:Bind AddExeCommand}"
        Content="{uid:Strings Uid=AddExe}"
      />
    </setting:SettingsExpander.ItemsFooter>
  </setting:SettingsExpander>
</UserControl>
