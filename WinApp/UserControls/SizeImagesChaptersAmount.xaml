<?xml version="1.0" encoding="utf-8" ?>
<UserControl
  x:Class="UnoLibrary.SizeImagesChaptersAmount"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:uid="using:UnoLibrary.Strings"
  mc:Ignorable="d"
>
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="ms-appx:///UnoLibrary/ValueConverters.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>
  <StackPanel Orientation="Horizontal" Spacing="4">
    <!--  文件大小  -->
    <TextBlock Text="{x:Bind Manga.FileSize, Mode=OneWay, Converter={StaticResource size2}}" />
    <!--  章节数量  -->
    <TextBlock>
      <Run Text="{x:Bind Manga.Chapters.Count, Mode=OneWay}" />

      <Run Text="{uid:Strings Uid=Chapters}" />
    </TextBlock>

    <!--  图片数量  -->
    <TextBlock>
      <Run Text="{x:Bind Manga.ImageAmount, Mode=OneWay}" />

      <Run Text="{uid:Strings Uid=Images}" />
    </TextBlock>
  </StackPanel>
</UserControl>
