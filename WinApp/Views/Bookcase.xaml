<Page
  x:Class="WinApp.Views.MainPageChildPages.Bookcase"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:complexmanga="using:WinApp.UserControls"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:info="using:WinApp.UserControls.MangaBasicInfo"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:models="using:Core.Models"
  xmlns:uid="using:UnoLibrary.Strings"
  xmlns:usercontrols="using:WinApp.UserControls"
  xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
  Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
  mc:Ignorable="d"
>
  <Grid Background="Transparent" RowDefinitions="auto,*">
    <TextBlock
      x:Name="Bookcase_HintTextBlock"
      Grid.Row="0"
      Grid.RowSpan="2"
      HorizontalAlignment="Center"
      VerticalAlignment="Center"
      Style="{StaticResource HintTextBlockStyle}"
      Text="{uid:Strings Uid=NoSelectedFolder}"
      Visibility="Visible"
    />
    <CommandBar
      x:Name="BookcaseCommandBar"
      Grid.Row="0"
      VerticalAlignment="Stretch"
      VerticalContentAlignment="Center"
    >
      <CommandBar.Content>
        <ComboBox
          x:Name="combochangefolder"
          DisplayMemberPath="FolderPath"
          ItemsSource="{x:Bind ObservableCollectionVM.MangasGroups, Mode=OneWay}"
          SelectedItem="{x:Bind settingViewModel.AppConfig.General.DefaultBookcaseFolder, Mode=TwoWay, Converter={StaticResource displayfolder}}"
          SelectionChanged="Combochangefolder_SelectionChanged"
        />
      </CommandBar.Content>

      <AppBarElementContainer VerticalContentAlignment="Center">
        <NumberBox
          x:Name="numberbox"
          VerticalAlignment="Stretch"
          HorizontalContentAlignment="Center"
          VerticalContentAlignment="Center"
          AcceptsExpression="False"
          LargeChange="10"
          Minimum="1"
          SmallChange="1"
          SpinButtonPlacementMode="Inline"
          ValidationMode="InvalidInputOverwritten"
          ValueChanged="Numberbox_ValueChanged"
          Value="1"
        />
      </AppBarElementContainer>

      <AppBarElementContainer VerticalAlignment="Center" VerticalContentAlignment="Center">
        <usercontrols:MangaOpenButton ToolTipService.ToolTip="{uid:Strings Uid=DefaultWay}" />
      </AppBarElementContainer>

      <!-- ===================== 筛选 ===================== -->
      <AppBarButton AllowFocusOnInteraction="True" Icon="Filter" Label="筛选">
        <AppBarButton.Flyout>
          <Flyout x:Name="FilterFlyout">
            <ScrollViewer MaxHeight="520">
              <StackPanel Width="320" Spacing="10">
                <!-- ===== 显示模式 ===== -->
                <TextBlock FontWeight="SemiBold" Text="显示模式" />
                <RadioButtons
                  x:Name="DisplayModeRadio"
                  MaxColumns="2"
                  SelectedIndex="1"
                  SelectionChanged="DisplayModeRadio_SelectionChanged"
                >
                  <RadioButton Content="全部" Tag="0" />
                  <RadioButton Content="分页（每页 20）" Tag="1" />
                </RadioButtons>

                <MenuFlyoutSeparator />

                <!-- ===== 筛选条件 ===== -->
                <TextBlock FontWeight="SemiBold" Text="筛选条件" />

                <!-- 名称 -->
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                  <CheckBox
                    x:Name="ChkName"
                    Grid.Column="0"
                    MinWidth="0"
                    VerticalAlignment="Center"
                    Content="名称"
                  />
                  <TextBox
                    x:Name="TxtName"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    PlaceholderText="包含名称关键字"
                    IsEnabled="{x:Bind ChkName.IsChecked.Value, Mode=OneWay}"
                  />
                </Grid>

                <!-- 大小 -->
                <Grid ColumnDefinitions="Auto,*,Auto,*" ColumnSpacing="8">
                  <CheckBox
                    x:Name="ChkSize"
                    Grid.Column="0"
                    MinWidth="0"
                    VerticalAlignment="Center"
                    Content="大小 (MB)"
                  />
                  <TextBox
                    x:Name="TxtSizeMin"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    PlaceholderText="最小"
                    IsEnabled="{x:Bind ChkSize.IsChecked.Value, Mode=OneWay}"
                  />
                  <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="~" />
                  <TextBox
                    x:Name="TxtSizeMax"
                    Grid.Column="3"
                    VerticalAlignment="Center"
                    PlaceholderText="最大"
                    IsEnabled="{x:Bind ChkSize.IsChecked.Value, Mode=OneWay}"
                  />
                </Grid>

                <!-- 章节数 -->
                <Grid ColumnDefinitions="Auto,*,Auto,*" ColumnSpacing="8">
                  <CheckBox
                    x:Name="ChkChapter"
                    Grid.Column="0"
                    MinWidth="0"
                    VerticalAlignment="Center"
                    Content="章节数"
                  />
                  <TextBox
                    x:Name="TxtChapterMin"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    PlaceholderText="最小"
                    IsEnabled="{x:Bind ChkChapter.IsChecked.Value, Mode=OneWay}"
                  />
                  <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="~" />
                  <TextBox
                    x:Name="TxtChapterMax"
                    Grid.Column="3"
                    VerticalAlignment="Center"
                    PlaceholderText="最大"
                    IsEnabled="{x:Bind ChkChapter.IsChecked.Value, Mode=OneWay}"
                  />
                </Grid>
                <!-- 章节名 -->
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                  <CheckBox
                    x:Name="ChkChapterName"
                    Grid.Column="0"
                    MinWidth="0"
                    VerticalAlignment="Center"
                    Content="章节名"
                  />
                  <TextBox
                    x:Name="TxtChapterName"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    PlaceholderText="包含章节名关键字"
                    IsEnabled="{x:Bind ChkChapterName.IsChecked.Value, Mode=OneWay}"
                  />
                </Grid>
                <!-- 类型 -->
                <TextBlock FontWeight="SemiBold" Text="文件类型" />
                <StackPanel x:Name="FilterTypePanel" Orientation="Horizontal" Spacing="2">
                  <CheckBox
                    x:Name="ChkFolder"
                    Content="文件夹"
                    IsChecked="True"
                    Tag="__folder__"
                    Unchecked="TypeCheckBox_Unchecked"
                  />
                  <CheckBox
                    x:Name="ChkZip"
                    Content="压缩包"
                    IsChecked="True"
                    Tag=".zip"
                    Unchecked="TypeCheckBox_Unchecked"
                  />
                </StackPanel>

                <!-- 标签 -->
                <TextBlock FontWeight="SemiBold" Text="标签" />
                <toolkit:TokenizingTextBox
                  x:Name="TagTokenizingTextBox"
                  PlaceholderText="输入或选择标签"
                  TokenDelimiter="+"
                  ItemsSource="{x:Bind FilterVm.RequiredTags, Mode=OneWay}"
                  SuggestedItemsSource="{x:Bind AvailableTagsForUI, Mode=OneWay}"
                  TextChanged="TagTokenizingTextBox_TextChanged"
                  TokenItemAdded="TagTokenBox_TokenItemChanged"
                  TokenItemRemoved="TagTokenBox_TokenItemChanged"
                  TokenItemAdding="TagTokenBox_TokenItemAdding"
                >
                  <toolkit:TokenizingTextBox.QueryIcon>
                    <FontIconSource FontFamily="Segoe MDL2 Assets" Glyph="&#xE11A;" />
                  </toolkit:TokenizingTextBox.QueryIcon>
                  <toolkit:TokenizingTextBox.SuggestedItemTemplate>
                    <DataTemplate x:DataType="x:String">
                      <TextBlock Text="{x:Bind Mode=OneTime}" />
                    </DataTemplate>
                  </toolkit:TokenizingTextBox.SuggestedItemTemplate>
                </toolkit:TokenizingTextBox>

                <MenuFlyoutSeparator />

                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                  <Button
                    HorizontalAlignment="Stretch"
                    Click="ApplyFilter_Click"
                    Content="应用"
                    Style="{StaticResource AccentButtonStyle}"
                  />
                  <Button
                    Grid.Column="1"
                    HorizontalAlignment="Stretch"
                    Click="ClearFilter_Click"
                    Content="清除"
                  />
                </Grid>
              </StackPanel>
            </ScrollViewer>
          </Flyout>
        </AppBarButton.Flyout>
      </AppBarButton>

      <!-- ===================== 视图模式 ===================== -->
      <AppBarButton
        AllowFocusOnInteraction="True"
        Icon="Switch"
        Label="{uid:Strings Uid=SwitchViewMode}"
        Visibility="Visible"
      >
        <AppBarButton.Flyout>
          <MenuFlyout>
            <MenuFlyoutItem
              Command="{x:Bind ChangeMangaGridViewDataTemplateCommand}"
              CommandParameter="0"
              Text="{uid:Strings Uid=ThumanailViewMode}"
            />
            <MenuFlyoutItem
              Command="{x:Bind ChangeMangaGridViewDataTemplateCommand}"
              CommandParameter="1"
              Text="{uid:Strings Uid=TagsViewMode}"
            />
          </MenuFlyout>
        </AppBarButton.Flyout>
      </AppBarButton>
    </CommandBar>

    <usercontrols:MangasGridView
      x:Name="Bookcase_GridView"
      Grid.Row="1"
      Margin="4"
      x:FieldModifier="public"
      MangaSource="{x:Bind FilterVm.DisplayMangas, Mode=OneWay}"
      ItemTemplateIndex="{x:Bind settingViewModel.AppConfig.General.MangasGridViewDataTemplateKey}"
      MangaOperationViewModel="{x:Bind MangaOperationViewModel, Mode=OneWay}"
    />
  </Grid>
</Page>
