<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
  x:Class="WinApp.Views.ContentDialogPages.RenameCategoryName"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:uid="using:UnoLibrary.Strings"
  Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
  CloseButtonText="{uid:Strings Uid=Close}"
  IsPrimaryButtonEnabled="{x:Bind CheckNameValid(RenameBox.Text), Mode=OneWay}"
  PrimaryButtonText="{uid:Strings Uid=Rename}"
  mc:Ignorable="d"
>
  <TextBox x:Name="RenameBox" />
</ContentDialog>
