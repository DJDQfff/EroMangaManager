<ContentDialog
  x:Class="WinApp.Views.ContentDialogPages.OverviewInformation"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:basic="using:WinApp.UserControls.MangaBasicInfo"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:uid="using:UnoLibrary.Strings"
  xmlns:uno="using:UnoLibrary"
  Title="{x:Bind Manga.FilePath}"
  Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
  CloseButtonText="{uid:Strings Uid=Close}"
  mc:Ignorable="d"
>
  <Grid ColumnDefinitions="*,2*">
    <basic:Cover Grid.Column="0" Manga="{x:Bind Manga, Mode=OneWay}" />
    <Grid Grid.Column="1" RowDefinitions="auto,5*,auto">
      <TextBlock
        Text="{x:Bind Manga.FolderPath, Mode=OneWay}"
        TextAlignment="Justify"
        TextWrapping="Wrap"
      />
      <TextBlock Grid.Row="1" Text="{x:Bind Manga.FileFullName, Mode=OneWay}" TextWrapping="Wrap" />
      <uno:SizeImagesChaptersAmount Grid.Row="2" Manga="{x:Bind Manga, Mode=OneWay}" />
    </Grid>
  </Grid>
</ContentDialog>
