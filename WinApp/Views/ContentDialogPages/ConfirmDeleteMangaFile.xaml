<ContentDialog
  x:Class="UnoLibrary.ContentDialogPages.ConfirmDeleteMangaFile"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:uid="using:UnoLibrary.Strings"
  Title="{uid:Strings Uid=DeleteFile}"
  Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
  PrimaryButtonText="{uid:Strings Uid=Yes}"
  SecondaryButtonText="{uid:Strings Uid=No}"
  mc:Ignorable="d"
>
  <ContentDialog.Resources>
    <Style TargetType="TextBlock">
      <Setter Property="Margin" Value="4" />
    </Style>
  </ContentDialog.Resources>
  <Grid RowDefinitions="auto,*">
    <StackPanel Orientation="Vertical">
      <TextBlock Text="{x:Bind manga.Name}" />
      <TextBlock Text="{x:Bind manga.FilePath}" />
    </StackPanel>
    <Image Grid.Row="1" Source="{x:Bind manga.CoverUri}" />
  </Grid>
</ContentDialog>
