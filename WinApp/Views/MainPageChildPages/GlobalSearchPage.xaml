<Page
  x:Class="WinApp.Views.MainPageChildPages.GlobalSearchPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:app="using:WinApp"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:model="using:Core.Models"
  xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
  xmlns:uid="using:UnoLibrary.Strings"
  xmlns:usercontrol="using:WinApp.UserControls"
  Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
  mc:Ignorable="d"
>
  <Grid RowDefinitions="auto,*">
    <Grid Grid.Row="0" ColumnDefinitions="*,auto">
      <Grid Grid.Column="0" RowDefinitions="*,*">
        <AutoSuggestBox
          x:Name="NameAugoSuggestBox"
          Grid.Row="0"
          Grid.Column="0"
          VerticalAlignment="Top"
          VerticalContentAlignment="Stretch"
          Header="{uid:Strings Uid=SearchByName}"
          QueryIcon="Find"
          Text="{x:Bind viewmodel.SearchRequiredText, Mode=TwoWay}"
          TextChanged="NameBox_TextChanged"
        />
        <toolkit:TokenizingTextBox
          x:Name="MangaTagTokenizingTextBox"
          Grid.Row="1"
          Grid.Column="1"
          HorizontalAlignment="Stretch"
          VerticalAlignment="Stretch"
          Header="{uid:Strings Uid=SearchByTag}"
          ItemsSource="{x:Bind viewmodel.SearchRequiredTags, Mode=OneWay}"
          SuggestedItemsSource="{x:Bind viewmodel.SearchAvailableTags, Mode=OneWay}"
          TextChanged="TagTokenizingTextBox_TextChanged"
          TokenDelimiter="+"
          TokenItemAdded="TagTokenBox_TokenItemChanged"
          TokenItemAdding="TagTokenBox_TokenItemAdding"
          TokenItemRemoved="TagTokenBox_TokenItemChanged"
        >
          <toolkit:TokenizingTextBox.QueryIcon>
            <FontIconSource FontFamily="Segoe MDL2 Assets" Glyph="&#xE11A;" />
          </toolkit:TokenizingTextBox.QueryIcon>
          <toolkit:TokenizingTextBox.SuggestedItemTemplate>
            <DataTemplate x:DataType="x:String">
              <TextBlock Text="{x:Bind Mode=OneTime}" />
            </DataTemplate>
          </toolkit:TokenizingTextBox.SuggestedItemTemplate>
        </toolkit:TokenizingTextBox>
      </Grid>
    </Grid>
    <usercontrol:MangasGridView
      x:Name="ResultGridView"
      Grid.Row="1"
      ItemTemplateIndex="{x:Bind settingViewModel.AppConfig.General.MangasGridViewDataTemplateKey}"
      ItemsSource="{x:Bind viewmodel.SearchResultMangas, Mode=OneWay}"
    />
  </Grid>
</Page>
