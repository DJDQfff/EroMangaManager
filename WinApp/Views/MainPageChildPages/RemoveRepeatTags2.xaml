<?xml version="1.0" encoding="utf-8" ?>
<Page
  x:Class="WinApp.Views.MainPageChildPages.RemoveRepeatTags2"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:local="using:WinApp.Views.MainPageChildPages"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:model="using:Core.Models"
  xmlns:usercontrol="using:WinApp.UserControls"
  Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
  mc:Ignorable="d"
>
  <Grid>
    <ListView ItemsSource="{x:Bind RepaetBooks}">
      <ListView.ItemTemplate>
        <DataTemplate x:DataType="model:Manga">
          <usercontrol:RenameMangaByDragTag Manga="{x:Bind}" NameChanged="RemoveIfTagRepeat" />
        </DataTemplate>
      </ListView.ItemTemplate>
    </ListView>
  </Grid>
</Page>
