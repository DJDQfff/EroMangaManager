<?xml version="1.0" encoding="utf-8" ?>
<Page
  x:Class="WinApp.Views.MainPageChildPages.ServerPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:local="using:WinApp.Views.MainPageChildPages"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:server="using:Server"
  mc:Ignorable="d"
>
  <Grid RowDefinitions="auto,*">
    <!--  ========== 上半部分：服务控制 ==========  -->
    <Border
      Grid.Row="0"
      Margin="20,20,20,10"
      Padding="20"
      Background="{ThemeResource CardBackgroundFillColorDefault}"
      CornerRadius="8"
    >
      <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto">
        <!--  标题  -->
        <TextBlock
          Grid.Row="0"
          Grid.ColumnSpan="2"
          Margin="0,0,0,12"
          FontSize="20"
          FontWeight="SemiBold"
          Text="服务控制"
        />

        <!--  状态指示  -->
        <Border
          x:Name="statusDot"
          Grid.Row="1"
          Grid.Column="0"
          Width="12"
          Height="12"
          Margin="0,0,8,0"
          VerticalAlignment="Center"
          Background="#FF4444"
          CornerRadius="6"
        />
        <TextBlock
          x:Name="txtStatus"
          Grid.Row="1"
          Grid.Column="1"
          VerticalAlignment="Center"
          FontSize="14"
          Text="未启动"
        />

        <!--  IP 和端口  -->
        <TextBlock
          Grid.Row="2"
          Grid.Column="0"
          Margin="0,12,0,0"
          VerticalAlignment="Center"
          FontSize="14"
          Text="地址："
        />
        <Border
          Grid.Row="2"
          Grid.Column="1"
          Margin="0,12,0,0"
          Padding="10,6"
          Background="{ThemeResource SolidBackgroundFillColorTertiary}"
          CornerRadius="4"
        >
          <TextBlock
            x:Name="txtFullAddress"
            FontFamily="Consolas"
            FontSize="14"
            Foreground="{ThemeResource SystemControlForegroundAccentBrush}"
            IsTextSelectionEnabled="True"
            Text="---"
          />
        </Border>
        <!--  错误提示  -->
        <HyperlinkButton
          Grid.Row="3"
          Content="Android APP Download"
          NavigateUri="https://github.com/DJDQfff/EroMangaManager/releases/latest"
        />

        <TextBlock
          x:Name="txtError"
          Grid.Row="4"
          Grid.ColumnSpan="2"
          Margin="0,12,0,0"
          FontSize="13"
          Foreground="#FF4444"
          TextWrapping="Wrap"
          Visibility="Collapsed"
        />

        <!--  按钮  -->
        <Button
          x:Name="btnStart"
          Grid.Row="5"
          Grid.ColumnSpan="2"
          Height="36"
          Margin="0,16,0,0"
          HorizontalAlignment="Stretch"
          Click="BtnStart_Click"
          Content="启动服务"
          CornerRadius="6"
        />
        <!--  加载动画  -->
        <ProgressRing
          x:Name="progressRing"
          Grid.Row="6"
          Grid.ColumnSpan="2"
          Margin="0,8,0,0"
          HorizontalAlignment="Center"
          Visibility="Collapsed"
        />
      </Grid>
    </Border>

    <!--  ========== 下半部分：日志 ==========  -->
    <Border
      Grid.Row="1"
      Margin="20,10,20,20"
      Padding="16"
      Background="{ThemeResource CardBackgroundFillColorDefault}"
      CornerRadius="8"
    >
      <Grid RowDefinitions="Auto,*">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
          <TextBlock
            VerticalAlignment="Center"
            FontSize="16"
            FontWeight="SemiBold"
            Text="运行日志"
          />
          <Button
            x:Name="btnClearLog"
            Grid.Column="1"
            Height="28"
            Click="BtnClearLog_Click"
            Content="清除"
            FontSize="12"
          />
        </Grid>

        <ListView x:Name="logListView" Grid.Row="1" Margin="0,8,0,0">
          <ListView.ItemTemplate>
            <!--  模拟一条日志在 UI 上的显示效果  -->
            <DataTemplate x:DataType="server:LogEntry">
              <!--
                                实际显示效果：
                                14:32:05 200  [INFO]  192.168.2.100  GET  /folders/basicinfo  15ms
                            -->

              <Grid Margin="0,2" ColumnDefinitions="Auto,Auto,Auto,*,Auto">
                <!--  时间  -->
                <TextBlock
                  Grid.Column="0"
                  Margin="0,0,8,0"
                  VerticalAlignment="Center"
                  FontFamily="Consolas"
                  FontSize="12"
                  Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                  Text="{x:Bind Time}"
                />

                <!--  级别  -->
                <Border
                  Grid.Column="1"
                  Margin="0,0,8,0"
                  Padding="4,1"
                  VerticalAlignment="Center"
                  Background="#2ECC71"
                  CornerRadius="2"
                >
                  <TextBlock FontSize="10" Foreground="White" Text="{x:Bind Level}" />
                </Border>

                <!--  地址  -->
                <TextBlock
                  Grid.Column="2"
                  Margin="0,0,8,0"
                  VerticalAlignment="Center"
                  FontFamily="Consolas"
                  FontSize="11"
                  Foreground="#888"
                  Text="{x:Bind IPAddress}"
                />

                <!--  方法与路径  -->
                <TextBlock
                  Grid.Column="3"
                  VerticalAlignment="Center"
                  FontFamily="Consolas"
                  FontSize="12"
                >
                  <Run FontWeight="SemiBold" Text="{x:Bind Method}" />
                  <Run Text=" " />
                  <Run Text="{x:Bind Path}" />
                </TextBlock>

                <!--  耗时  -->
                <TextBlock
                  Grid.Column="4"
                  Margin="8,0,0,0"
                  VerticalAlignment="Center"
                  FontFamily="Consolas"
                  FontSize="11"
                  Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                  Text="{x:Bind ElapsedDisplay}"
                />
              </Grid>
            </DataTemplate>
          </ListView.ItemTemplate>
        </ListView>
      </Grid>
    </Border>
  </Grid>
</Page>
