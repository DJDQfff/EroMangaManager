<Page
  x:Class="WinApp.Views.FunctionChildPages.FindSameManga"
  x:Name="findsampage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:control="using:WinApp.UserControls"
  xmlns:coremodel="using:Core.Models"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:functionchildpages="using:WinApp.Views.FunctionChildPages"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:uid="using:UnoLibrary.Strings"
  Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
  mc:Ignorable="d"
>
  <Grid RowDefinitions="auto,*">
    <StackPanel Orientation="Horizontal">
      <ComboBox x:Name="combobox" SelectedIndex="0">
        <ComboBoxItem Content="{uid:Strings Uid=Method1}" />
        <ComboBoxItem Content="{uid:Strings Uid=Method2}" />
        <ComboBoxItem Content="{uid:Strings Uid=Method3}" />
        <ComboBoxItem Content="{uid:Strings Uid=Method4}" />
      </ComboBox>
      <Button Click="Button_Click" Content="{uid:Strings Uid=Start}" />
      <ProgressRing IsActive="{x:Bind viewModel.IsWorking, Mode=OneWay}" />
    </StackPanel>
    <ListView
      x:Name="listView"
      Grid.Row="1"
      ItemsSource="{x:Bind viewModel.RepeatPairs, Mode=OneWay}"
      SelectionMode="None"
    >
      <ListView.ItemContainerStyle>
        <Style TargetType="ListViewItem">
          <Setter Property="HorizontalContentAlignment" Value="Stretch" />
          <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
      </ListView.ItemContainerStyle>
      <ListView.ItemTemplate>
        <DataTemplate x:DataType="coremodel:RepeatMangasGroup">
          <Expander
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Stretch"
            IsExpanded="True"
          >
            <Expander.Header>
              <CommandBar VerticalContentAlignment="Center" Content="{x:Bind Key}" />
            </Expander.Header>
            <Expander.Content>
              <control:MangasGridView
                ItemTemplateIndex="Template2"
                MangaOperationViewModel="{Binding MangaOperationViewModel,ElementName=findsampage,Mode=OneWay}"
                MangaSource="{x:Bind Collections}"
              />
            </Expander.Content>
          </Expander>
        </DataTemplate>
      </ListView.ItemTemplate>
    </ListView>
  </Grid>
</Page>
