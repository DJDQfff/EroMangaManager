<Page
  x:Class="UnoApp.NavigationPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:dto="using:Core.DTOs"
  xmlns:library="using:UnoLibrary"
  xmlns:local="using:UnoApp"
  xmlns:model="using:Core.Models"
  xmlns:string="using:UnoLibrary.Strings"
  x:Name="rootPage"
  Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
>
  <Page.Resources>
    <MenuFlyout x:Key="flyout" Opened="MenuFlyout_Opened">
      <MenuFlyoutItem
        Command="{Binding ViewModel.DeleteCommand, ElementName=rootPage}"
        Text="删除"
      />
      <MenuFlyoutSeparator />
      <MenuFlyoutSubItem x:Name="TagSubItem" Text="搜索Tag" />
    </MenuFlyout>
  </Page.Resources>

  <NavigationView
    x:Name="navigationview"
    Grid.Row="1"
    ItemInvoked="Navigationview_ItemInvoked"
    PaneDisplayMode="Top"
  >
    <NavigationView.MenuItems>
      <NavigationViewItem Content="随机本子" />
      <NavigationViewItem Content="随机标签" />
      <NavigationViewItem />
    </NavigationView.MenuItems>

    <NavigationView.Content>
      <Grid RowDefinitions="auto,*">
        <CommandBar Grid.Row="0" VerticalAlignment="Center" OverflowButtonVisibility="Collapsed">
          <CommandBar.Content>
            <ComboBox
              x:Name="combobox"
              DisplayMemberPath="Name"
              ItemsSource="{x:Bind ViewModel.Groups, Mode=OneWay}"
              SelectedItem="{x:Bind ViewModel.SelectedGroup, Mode=TwoWay}"
              SelectionChanged="{x:Bind ViewModel.UpdateSelectedGroupRandomManga}"
            />
          </CommandBar.Content>
          <CommandBar.PrimaryCommands>
            <AppBarElementContainer>
              <ComboBox
                Width="80"
                Height="40"
                ItemsSource="{x:Bind ViewModel.DisplayAmountOptions}"
                SelectedItem="{x:Bind ViewModel.DisplayAmount, Mode=TwoWay}"
              />
            </AppBarElementContainer>
            <AppBarElementContainer Visibility="Collapsed">
              <Grid ColumnDefinitions="auto,*,auto">
                <RepeatButton Content="加" />
                <ComboBox />
                <RepeatButton Content="减" />
              </Grid>
            </AppBarElementContainer>
            <AppBarElementContainer VerticalContentAlignment="Center">
              <NumberBox
                x:Name="numberbox"
                VerticalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                AcceptsExpression="False"
                LargeChange="10"
                Minimum="1"
                SmallChange="1"
                SpinButtonPlacementMode="Inline"
                ValidationMode="InvalidInputOverwritten"
                ValueChanged="Numberbox_ValueChanged"
                Visibility="Collapsed"
                Value="1"
              />
            </AppBarElementContainer>
          </CommandBar.PrimaryCommands>
        </CommandBar>
        <RefreshContainer
          x:Name="refresh"
          Grid.Row="1"
          RefreshRequested="{x:Bind ViewModel.UpdateSelectedGroupRandomManga}"
        >
          <ListView
            x:Name="MangaListView"
            IsItemClickEnabled="True"
            ItemClick="Gridview_ItemClick"
            ItemsSource="{x:Bind ViewModel.Mangas, Mode=OneWay}"
            ScrollViewer.VerticalScrollBarVisibility="Visible"
            SelectionMode="None"
          >
            <ListView.ItemTemplate>
              <DataTemplate x:DataType="model:Manga">
                <Grid ColumnDefinitions="2*,3*">
                  <Image
                    Grid.Column="0"
                    ContextFlyout="{StaticResource menuflyout}"
                    DataContext="{x:Bind}"
                    Source="{x:Bind CoverUri, Converter={StaticResource base64toimageconverter}, Mode=OneWay}"
                    Stretch="Uniform"
                  />
                  <Grid Grid.Column="1" HorizontalAlignment="Stretch" RowDefinitions="auto,*">
                    <Grid Grid.Row="0" RowDefinitions="*,*">
                      <Grid ColumnDefinitions="*,auto">
                        <StackPanel Grid.Column="0" Orientation="Vertical">
                          <TextBlock Margin="0,4,0,0" Text="{x:Bind Name}" TextWrapping="Wrap" />
                          <library:SizeImagesChaptersAmount Manga="{x:Bind Mode=OneWay}" />
                          <ProgressBar
                            x:Name="progressbar"
                            Grid.Column="0"
                            Height="8"
                            HorizontalAlignment="Stretch"
                            Foreground="{ThemeResource SystemAccentColor}"
                            IsIndeterminate="True"
                            Maximum="100"
                            ShowError="False"
                            ShowPaused="False"
                            Visibility="Collapsed"
                          />
                        </StackPanel>
                        <Button
                          Grid.Column="1"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Bottom"
                          ClickMode="Release"
                          DataContext="{x:Bind}"
                          Flyout="{StaticResource flyout}"
                        >
                          <SymbolIcon Symbol="More" />
                        </Button>
                      </Grid>
                      <Grid />
                    </Grid>
                    <ItemsControl Grid.Row="1" ItemsSource="{x:Bind Tags}">
                      <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                          <Setter Property="VerticalAlignment" Value="Top" />
                        </Style>
                      </ItemsControl.ItemContainerStyle>
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <StackPanel Orientation="Horizontal" Spacing="4" />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                          <Border
                            Padding="4,2"
                            Background="{ThemeResource SystemAccentColor}"
                            CornerRadius="4"
                          >
                            <TextBlock FontSize="11" Foreground="White" Text="{x:Bind}" />
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </Grid>
                </Grid>
              </DataTemplate>
            </ListView.ItemTemplate>
          </ListView>
        </RefreshContainer>
      </Grid>
    </NavigationView.Content>
  </NavigationView>
</Page>
