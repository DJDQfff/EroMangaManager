<Page
  x:Class="UnoApp.NavigationPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:controls="using:CommunityToolkit.WinUI.Controls"
  xmlns:dto="using:Core.DTOs"
  xmlns:local="using:UnoApp"
  xmlns:unolibrary="using:UnoLibrary"
  xmlns:model="using:Core.Models"
  x:Name="rootPage"
  Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
>
  <Grid RowDefinitions="auto,*">
    <CommandBar Grid.Row="0" VerticalAlignment="Center" OverflowButtonVisibility="Collapsed">
      <CommandBar.Content>
        <ComboBox
          x:Name="combobox"
          DisplayMemberPath="Name"
          ItemsSource="{x:Bind ViewModel.Groups, Mode=OneWay}"
          SelectedItem="{x:Bind ViewModel.SelectedGroup, Mode=TwoWay}"
          SelectionChanged="{x:Bind ViewModel.UpdateSelectedGroupRandomManga}"
        />
      </CommandBar.Content>
      <CommandBar.PrimaryCommands>
        <AppBarElementContainer>
          <ComboBox
            Width="80"
            Height="40"
            ItemsSource="{x:Bind ViewModel.DisplayAmountOptions}"
            SelectedItem="{x:Bind ViewModel.DisplayAmount, Mode=TwoWay}"
          />
        </AppBarElementContainer>
        <AppBarElementContainer Visibility="Collapsed">
          <Grid ColumnDefinitions="auto,*,auto">
            <RepeatButton Content="加" />
            <ComboBox />
            <RepeatButton Content="减" />
          </Grid>
        </AppBarElementContainer>
        <AppBarElementContainer VerticalContentAlignment="Center">
          <NumberBox
            x:Name="numberbox"
            VerticalAlignment="Stretch"
            HorizontalContentAlignment="Center"
            VerticalContentAlignment="Center"
            AcceptsExpression="False"
            LargeChange="10"
            Minimum="1"
            SmallChange="1"
            SpinButtonPlacementMode="Inline"
            ValidationMode="InvalidInputOverwritten"
            ValueChanged="Numberbox_ValueChanged"
            Visibility="Collapsed"
            Value="1"
          />
        </AppBarElementContainer>
      </CommandBar.PrimaryCommands>
    </CommandBar>
    <Grid Grid.Row="1">
      <RefreshContainer
        x:Name="refresh"
        Grid.Row="1"
        RefreshRequested="{x:Bind ViewModel.UpdateSelectedGroupRandomManga}"
      >
        <ListView
          x:Name="MangaListView"
          IsItemClickEnabled="True"
          ItemClick="Gridview_ItemClick"
          ItemsSource="{x:Bind ViewModel.Mangas, Mode=OneWay}"
          ScrollViewer.VerticalScrollBarVisibility="Visible"
          SelectionMode="None"
        >
          <ListView.ItemTemplate>
            <DataTemplate x:DataType="model:Manga">
              <!--  1. 增加一行用于放置 ProgressBar (auto,auto,*,auto)  -->
              <Grid Height="300" Background="Transparent" RowDefinitions="auto,auto,*,auto">
                <!--  2. 第一行：Name + More 按钮  -->
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                  <TextBlock
                    Grid.Column="0"
                    Margin="0,0,0,4"
                    VerticalAlignment="Center"
                    Text="{x:Bind Name}"
                    TextWrapping="Wrap"
                  />

                  <Button
                    Grid.Column="1"
                    Padding="4"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    BorderThickness="0"
                  >
                    <FontIcon FontSize="16" Glyph="&#xE712;" />
                    <Button.Flyout>
                      <MenuFlyout
                        Opening="SharedMangaFlyout_Opening"
                        Placement="BottomEdgeAlignedRight"
                      >
                        <MenuFlyoutItem x:Name="DeleteMenuItem" Text="删除" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutSubItem x:Name="TagSubItem" Text="搜索Tag" />
                      </MenuFlyout>
                    </Button.Flyout>
                  </Button>
                </Grid>

                <!--  🔥 3. 第二行：ProgressBar  -->
                <ProgressBar
                  x:Name="progressbar"
                  Grid.Row="1"
                  Height="3"
                  Margin="0,2"
                  IsIndeterminate="True"
                  Visibility="Collapsed"
                />

                <!--  4. 第三行：Cover + Tags，严格保持 1:1 比例  -->
                <Grid Grid.Row="2" ColumnDefinitions="*,*">
                  <Image
                    Grid.Column="0"
                    Source="{x:Bind CoverUri, Mode=OneWay}"
                    Stretch="Uniform"
                  />

                  <ItemsRepeater Grid.Column="1" ItemsSource="{x:Bind Tags}">
                    <ItemsRepeater.Layout>
                      <controls:WrapLayout HorizontalSpacing="4" VerticalSpacing="4" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                      <DataTemplate x:DataType="x:String">
                        <Border
                          Padding="4,2"
                          Background="{ThemeResource SystemAccentColor}"
                          CornerRadius="4"
                        >
                          <TextBlock FontSize="11" Foreground="White" Text="{x:Bind}" />
                        </Border>
                      </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                  </ItemsRepeater>
                </Grid>
                <!--  5. 第四行：Info 留空占位  -->
                <unolibrary:SizeImagesChaptersAmount Grid.Row="3" Manga="{x:Bind Mode=OneWay}" />
              </Grid>
            </DataTemplate>
          </ListView.ItemTemplate>
        </ListView>
      </RefreshContainer>
      <!--  2. 全局 ProgressBar (浮在顶层)  -->
      <!--  绑定到 ViewModel 的 IsLoading 属性  -->
      <ProgressBar
        x:Name="GlobalProgressBar"
        Height="4"
        VerticalAlignment="Top"
        x:Load="False"
        IsIndeterminate="True"
        Visibility="Collapsed"
      />
    </Grid>
  </Grid>
</Page>
