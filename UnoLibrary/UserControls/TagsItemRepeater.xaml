<?xml version="1.0" encoding="utf-8" ?>
<UserControl
  x:Class="WinApp.UserControls.MangaBasicInfo.TagsItemRepeater"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:basic="using:WinApp.UserControls.MangaBasicInfo"
  xmlns:controls="using:CommunityToolkit.WinUI.Controls"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:models="using:Core.Models"
  x:Name="RootUserControl"
  d:DataContext="{d:DesignInstance Type=models:Manga}"
  mc:Ignorable="d"
>
  <ItemsRepeater x:Name="WrapRepeater" ItemsSource="{x:Bind Manga.Tags, Mode=OneWay}">
    <ItemsRepeater.Layout>
      <controls:WrapLayout x:Name="Wrap" HorizontalSpacing="4" VerticalSpacing="4" />
    </ItemsRepeater.Layout>
    <ItemsRepeater.ItemTemplate>
      <DataTemplate x:DataType="x:String">
        <basic:TagTextBlock
          x:Name="tag"
          Text="{x:Bind}"
          CopyCommand="{Binding CopyCommand, ElementName=RootUserControl,Mode=OneWay}"
          NavigateCommand="{Binding NavigateCommand, ElementName=RootUserControl,Mode=OneWay}"
        />
      </DataTemplate>
    </ItemsRepeater.ItemTemplate>
  </ItemsRepeater>
</UserControl>
